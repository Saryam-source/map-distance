<!DOCTYPE html>
<html>
<head>
  <title>Zoho Forms PDF Template Update Tracker</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      color: #000;
    }

    h1 {
      text-align: center;
      color: #0b376d;
      font-size: 24px;
      margin-bottom: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th {
      background: #0b376d;
      color: white;
      padding: 8px;
      border: 1px solid #000;
    }

    td {
      border: 1px solid #000;
      padding: 7px;
      vertical-align: middle;
    }

    .center {
      text-align: center;
    }

    input[type="text"] {
      width: 95%;
      border: none;
      border-bottom: 1px solid #999;
      font-size: 13px;
      outline: none;
    }

    .date-box {
      margin-top: 5px;
      width: 90%;
      text-align: center;
      font-size: 11px;
    }

    .check-box {
      width: 18px;
      height: 18px;
    }

    button {
      margin-bottom: 15px;
      padding: 10px 18px;
      background: #0b376d;
      color: white;
      border: none;
      cursor: pointer;
      border-radius: 4px;
      font-size: 14px;
    }

    @media print {
      button {
        display: none;
      }

      input {
        border: none;
      }

      body {
        padding: 0;
      }
    }
  </style>
</head>
<body>

  <button onclick="window.print()">Download / Print PDF</button>

  <h1>ZOHO FORMS PDF TEMPLATE UPDATE TRACKER</h1>

  <table>
    <thead>
      <tr>
        <th>S.No</th>
        <th>Form Name</th>
        <th>Checked<br>✅</th>
        <th>Updated</th>
        <th>Completed<br>✅</th>
        <th>Issue</th>
      </tr>
    </thead>

    <tbody id="tableBody"></tbody>
  </table>

  <script>
    const forms = [
      "Material/Tools Returned from Site",
      "Travel Expense Forms",
      "Travel Advance Request Form (TARF)",
      "Service Report",
      "Installation Report",
      "Site Work Report (Weekly)",
      "Leave Travel Allowance (LTA) Claim Form",
      "Advance Request Form",
      "Monthly Expense",
      "Additional Requirement Form",
      "Extended Work Report",
      "Final Acceptance Certificate",
      "Material Loss / Damage / Repair Report",
      "Minutes of Meeting (MOM)",
      "No Dues Form",
      "Employee Information",
      "Work Compensation Form (WCF)",
      "Kilometer Calculate Form",
      "Jenoptik Service Report"
    ];

    const tableBody = document.getElementById("tableBody");

    forms.forEach((form, index) => {
      const row = `
        <tr>
          <td class="center">${index + 1}</td>
          <td>${form}</td>

          <td class="center">
            <input type="checkbox" class="check-box"><br>
            <input type="text" class="date-box" placeholder="dd-mm-yyyy">
          </td>

          <td>
            <input type="text" placeholder="Write update details">
          </td>

          <td class="center">
            <input type="checkbox" class="check-box"><br>
            <input type="text" class="date-box" placeholder="dd-mm-yyyy">
          </td>

          <td>
            <input type="text" placeholder="Write issue">
          </td>
        </tr>
      `;

      tableBody.innerHTML += row;
    });
  </script>

</body>
</html>
